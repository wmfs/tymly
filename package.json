{
  "name": "tymly",
  "description": "An empty husk for synchronizing Tymly related packages, plugins, blueprints etc.",
  "version": "0.0.0",
  "author": "Tim Needham",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=12"
  },
  "scripts": {
    "sync": "node ./lib/sync",
    "sync:dry": "node ./lib/sync --dry-run",
    "sync:verbose": "node ./lib/sync --verbose",
    "sync:public-only": "node ./lib/sync --public-only",
    "sync:no-install": "node ./lib/sync --no-install",
    "bootstrap": "node ./lib/clean && pnpm install",
    "clean": "node ./lib/clean",
    "test": "pnpm -r test",
    "clean-git-remotes:dry": "node ./lib/clean-git-remotes",
    "clean-git-remotes": "node ./lib/clean-git-remotes --apply"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wmfs/tymly"
  },
  "bugs": {
    "url": "https://github.com/wmfs/tymly/issues"
  },
  "dependencies": {
    "@wmfs/lerna-sync": "wmfs/lerna-sync#meenahoda/sc-33783/improve-lerna-sync-scalability"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
