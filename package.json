{
  "name": "tymly",
  "description": "An empty husk for synchronizing Tymly related packages, plugins, blueprints etc.",
  "version": "0.0.0",
  "author": "Tim Needham",
  "scripts": {
    "bootstrap": "lerna clean --yes && lerna bootstrap && lerna link --force-local",
    "clean": "lerna clean --yes",
    "test": "lerna run test",
    "sync": "node ./lib/sync",
    "sync:dry": "node ./lib/sync --dry-run",
    "sync:verbose": "node ./lib/sync --verbose",
    "sync:public-only": "node ./lib/sync --public-only",
    "clean-git-remotes-dry": "node ./lib/clean-git-remotes",
    "clean-git-remotes": "node ./lib/clean-git-remotes --apply"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wmfs/tymly"
  },
  "bugs": {
    "url": "https://github.com/wmfs/tymly/issues"
  },
  "dependencies": {
    "@wmfs/lerna-sync": "1.37.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
